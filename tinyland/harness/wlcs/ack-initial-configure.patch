+void wlcs::XdgSurfaceStable::commit_and_ack_initial_configure(wlcs::Client& client, wlcs::Surface& surface)
+{
+    bool configured = false;
+    EXPECT_CALL(*this, configure(testing::_))
+        .WillOnce(
+            [&configured, shell_surface = shell_surface](uint32_t serial)
+            {
+                xdg_surface_ack_configure(shell_surface, serial);
+                configured = true;
+            });
+    wl_surface_commit(surface);
+    client.dispatch_until([&configured]() { return configured; });
+    testing::Mock::VerifyAndClearExpectations(this);
+    ON_CALL(*this, configure(testing::_))
+        .WillByDefault(
+            [shell_surface = shell_surface](uint32_t serial)
+            {
+                xdg_surface_ack_configure(shell_surface, serial);
+            });
+}
